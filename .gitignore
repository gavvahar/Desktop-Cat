.env
.lh
__pycache__/
*.py[cod]
node_modules
.vscode

# AppImage build artifacts (packaging/appimage/build.sh regenerates these;
# only the source files -- AppRun, desktop-cat.desktop, desktop-cat.png,
# build.sh itself -- are tracked)
packaging/appimage/.tools/
packaging/appimage/build/
packaging/appimage/dist/
packaging/appimage/AppDir/
packaging/appimage/*.spec
packaging/appimage/*.AppImage

# Windows .exe build artifacts (packaging/windows/build.ps1 regenerates
# these; only the source files -- build.ps1, desktop-cat.ico -- are tracked)
packaging/windows/build/
packaging/windows/dist/
packaging/windows/*.spec

# macOS .app build artifacts (packaging/macos/build.sh regenerates these;
# only the source files -- build.sh, desktop-cat.icns -- are tracked)
packaging/macos/build/
packaging/macos/dist/
packaging/macos/*.spec

# Flatpak build artifacts (packaging/flatpak/build.sh regenerates these;
# only the manifest/desktop/metainfo/launcher/build.sh source files are
# tracked)
packaging/flatpak/.flatpak-builder/
packaging/flatpak/build-dir/
packaging/flatpak/repo/
packaging/flatpak/*.flatpak