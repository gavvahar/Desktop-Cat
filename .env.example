# Copy to .env and fill in for real deployment. docker-compose.yml loads
# this file automatically.

# Long random string -- e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

DJANGO_DEBUG=false

# Comma-separated. Must include whatever domain this is actually served on.
DJANGO_ALLOWED_HOSTS=downloads.example.com

GITHUB_REPO=gavvahar/Desktop-Cat

# Required if the repo is private -- without it, both the release-info API
# call and the /dl/... download redirect will fail for every visitor.
# Needs read access to the repo's contents (classic PAT: "repo" scope;
# fine-grained PAT: "Contents: Read" on this repo). Optional while the
# repo is public -- still useful there too, since it raises the GitHub API
# rate limit from 60/hr to 5000/hr, shared across all visitors since
# fetches happen server-side (release data is cached 5 minutes regardless,
# so this matters less at low traffic).
GITHUB_TOKEN=

# SQLite file path. Must be /data/db.sqlite3 for Docker (compose.yml mounts
# the db-data volume at /data) so the database survives container rebuilds.
# Leave blank for non-Docker local dev -- defaults to a data/ dir alongside
# the site's manage.py.
DJANGO_DB_PATH=/data/db.sqlite3

# File-based cache dir for sessions, kept separate from DJANGO_CACHE_DIR so
# session churn can't evict the GitHub release cache (or vice versa).
DJANGO_SESSION_CACHE_DIR=

# Outbound email for account verification. Leave EMAIL_HOST blank to use
# the console backend (prints emails to stdout) for local/dev testing.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@desktopcat.local
